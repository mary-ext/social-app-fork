{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": ["ESNext", "DOM"],
		"module": "esnext",
		"types": [
			"@atcute/atproto",
			"@atcute/bluesky",
			"@atcute/germ",
			"@atcute/microcosm",
			"@atcute/ozone",
			"wicg-file-system-access"
		],
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,

		"paths": {
			"#/*": ["./src/*"],
			"react": ["./node_modules/@oomfware/scion/types/react.d.ts"],
			"react/compiler-runtime": ["./node_modules/@oomfware/scion/types/compiler-runtime.d.ts"],
			"react/jsx-dev-runtime": ["./node_modules/@oomfware/scion/types/jsx-runtime.d.ts"],
			"react/jsx-runtime": ["./node_modules/@oomfware/scion/types/jsx-runtime.d.ts"],
			"react-dom": ["./node_modules/@oomfware/scion/types/react-dom.d.ts"],
			"react-dom/client": ["./node_modules/@oomfware/scion/types/react-dom-client.d.ts"],
			"scheduler": ["./node_modules/@oomfware/scion/types/scheduler.d.ts"],
			"use-sync-external-store/shim": [
				"./node_modules/@oomfware/scion/types/use-sync-external-store-shim.d.ts"
			]
		}
	},
	"include": ["index.tsx", "src"]
}
