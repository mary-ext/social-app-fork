{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"jsdoc": {
		"capitalizeDescriptions": false
	},
	"sortImports": {
		"groups": [
			["side_effect", "side_effect_style"],

			"builtin",
			{ "newlinesBetween": false },
			"cloudflare",

			"react",
			"atcute",
			"oomfware",
			"external",

			"lib",
			"state",
			"locale",
			"features",
			"screens",
			"components",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"unknown"
		],
		"customGroups": [
			{
				"groupName": "cloudflare",
				"elementNamePattern": ["cloudflare:**"]
			},
			{
				"groupName": "react",
				"elementNamePattern": ["react", "react/**"]
			},
			{
				"groupName": "atcute",
				"elementNamePattern": ["@atcute/**"]
			},
			{
				"groupName": "oomfware",
				"elementNamePattern": ["@mary/**", "@mary-ext/**", "@oomfware/**"]
			},
			{
				"groupName": "lib",
				"elementNamePattern": ["#/lib", "#/lib/**"]
			},
			{
				"groupName": "state",
				"elementNamePattern": ["#/state", "#/state/**"]
			},
			{
				"groupName": "locale",
				"elementNamePattern": ["#/locale", "#/locale/**"]
			},
			{
				"groupName": "features",
				"elementNamePattern": ["#/features", "#/features/**"]
			},
			{
				"groupName": "screens",
				"elementNamePattern": ["#/screens", "#/screens/**"]
			},
			{
				"groupName": "components",
				"elementNamePattern": ["#/components", "#/components/**"]
			}
		]
	},
	"ignorePatterns": ["node_modules", "pnpm-lock.yaml", "src/paraglide"],
	"overrides": [
		{
			"files": ["tsconfig*.json"],
			"options": { "parser": "jsonc" }
		},
		{
			"files": ["*.md"],
			"options": { "printWidth": 100, "proseWrap": "always" }
		}
	]
}
