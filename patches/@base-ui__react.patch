diff --git a/utils/popups/closeAllPopups.mjs b/utils/popups/closeAllPopups.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..90969e6742fa7dd5a3467e518d583a9e4feb0e6d
--- /dev/null
+++ b/utils/popups/closeAllPopups.mjs
@@ -0,0 +1,35 @@
+'use client';
+
+import { useIsoLayoutEffect } from '@base-ui/utils/useIsoLayoutEffect';
+
+const closeActions = new Set();
+
+/**
+ * closes every registered floating popup immediately, without waiting for an exit animation.
+ *
+ * dialogs and tooltips do not register themselves. controlled popups must honor their `onOpenChange`
+ * callback to remain closed after the immediate unmount.
+ */
+export function closeAllPopups() {
+  for (const close of Array.from(closeActions)) {
+    close();
+  }
+}
+
+/**
+ * registers an immediate close action while a floating popup is mounted.
+ *
+ * @param mounted whether the popup is mounted
+ * @param close action that closes and unmounts the popup
+ */
+export function useRegisterPopupCloseAction(mounted, close) {
+  useIsoLayoutEffect(() => {
+    if (!mounted) {
+      return undefined;
+    }
+    closeActions.add(close);
+    return () => {
+      closeActions.delete(close);
+    };
+  }, [mounted, close]);
+}
