{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"screens.search.account.emptyInterest": "No results for \"{interest}\".",
	"screens.search.account.loadError": "Failed to load suggested follows",
	"screens.search.account.searchMore": "Search for more accounts",
	"screens.search.account.title": "Suggested accounts",
	"screens.search.byCreator": "By {handle}",
	"screens.search.explore.back": "Back to explore",
	"screens.search.explore.loadMore": "Load more",
	"screens.search.feeds.error.load": "Failed to load feeds",
	"screens.search.feeds.error.loadPrefs": "Failed to load feeds preferences",
	"screens.search.feeds.error.loadSuggested": "Failed to load suggested feeds",
	"screens.search.feeds.loadMore": "Load more suggested feeds",
	"screens.search.feeds.searchMore": "Search for more feeds",
	"screens.search.feeds.title": "Discover new feeds",
	"screens.search.input.description": "Find posts, users, and feeds on Bluesky",
	"screens.search.input.placeholder": "Search for posts, users, or feeds",
	"screens.search.results.empty": "No results found for “{#t0}{query}{/t0}”.",
	"screens.search.results.emptyHint": "Try a different search term, or use search filters to narrow the results.",
	"screens.search.results.error.failed": "Couldn't complete your search.",
	"screens.search.results.error.failedRetryable": "Couldn't complete your search right now.",
	"screens.search.results.error.generic": "Error: {error}",
	"screens.search.results.loading": "Loading search results",
	"screens.search.starterPack.additionalCount": [
		{
			"declarations": ["input count", "local cp = count: plural", "local n = count: number"],
			"selectors": [],
			"match": {
				"": "+{n}"
			}
		}
	],
	"screens.search.starterPack.open": "Open pack",
	"screens.search.trending.postCount": [
		{
			"declarations": ["input count", "input formatted", "local cp = count: plural"],
			"selectors": ["cp"],
			"match": {
				"cp=one": "{formatted} post",
				"cp=other": "{formatted} posts"
			}
		}
	],
	"screens.search.trending.rank": [
		{
			"declarations": ["input rank", "local cp = rank: plural", "local n = rank: number"],
			"selectors": [],
			"match": {
				"": "{n}."
			}
		}
	]
}
