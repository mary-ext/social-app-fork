{
	"name": "bsky.app",
	"version": "1.122.0",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": "pnpm paraglide:compile && pnpm cf-typegen",
		"dev": "vite --experimentalBundle",
		"dev:worker": "wrangler dev --var DEV:true",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"build": "pnpm paraglide:compile && pnpm lint && vite build",
		"emoji:compile": "node scripts/build-emoji-data.ts",
		"paraglide:compile": "node scripts/compile-i18n.ts",
		"preview": "vite preview",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"nuke": "rm -rf ./node_modules ./web-build"
	},
	"dependencies": {
		"@atcute/atproto": "^4.0.4",
		"@atcute/bluesky": "^4.0.24",
		"@atcute/bluesky-moderation": "^4.2.2",
		"@atcute/bluesky-richtext-builder": "^4.0.1",
		"@atcute/bluesky-richtext-parser": "^2.1.2",
		"@atcute/bluesky-richtext-segmenter": "^3.0.2",
		"@atcute/bluesky-search-parser": "^0.2.0",
		"@atcute/cbor": "^2.3.8",
		"@atcute/cid": "^2.5.0",
		"@atcute/client": "^5.1.2",
		"@atcute/germ": "^1.0.2",
		"@atcute/identity": "^2.0.2",
		"@atcute/identity-resolver": "^2.0.2",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/microcosm": "^2.0.2",
		"@atcute/multibase": "^1.2.5",
		"@atcute/oauth-browser-client": "^5.1.0",
		"@atcute/oauth-cab": "^0.1.1",
		"@atcute/ozone": "^4.0.10",
		"@atcute/tangled": "^2.0.20",
		"@atcute/tid": "^1.1.4",
		"@atcute/uint8array": "^1.2.0",
		"@atcute/util-text": "^1.3.4",
		"@atcute/xrpc-server": "^2.0.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@mary-ext/array-fns": "^0.1.0",
		"@mary-ext/batch-fetch": "^0.1.0",
		"@mary-ext/color-fns": "^0.1.0",
		"@mary-ext/date-fns": "^0.1.0",
		"@mary-ext/exif-rm": "^0.1.0",
		"@mary-ext/simple-event-emitter": "^1.1.0",
		"@oomfware/cropper": "^0.1.0",
		"@oomfware/lightbox": "^0.1.9",
		"@oomfware/scion": "^0.1.8",
		"@oomfware/stacker": "^0.2.3",
		"@oomfware/tug": "^0.2.1",
		"@tanstack/react-query": "^5.104.1",
		"@vanilla-extract/css": "^1.21.2",
		"@vanilla-extract/dynamic": "^2.1.5",
		"clsx": "^2.1.1",
		"dequal": "^2.0.3",
		"highlight.js": "^11.12.0",
		"idb-keyval": "^6.3.0",
		"lowlight": "^3.3.0",
		"mediabunny": "^1.61.3",
		"tldts": "^7.4.16",
		"valibot": "^1.5.0",
		"wordgard": "0.5.2"
