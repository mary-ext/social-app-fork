{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "social-app-fork",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"secrets": {
		"required": ["OAUTH_PRIVATE_KEY"],
	},
	"ai": {
		"binding": "AI",
	},
	"ratelimits": [
		{
			// alt text drafting, charged per calling did. a round per image plus a couple of refinements is a
			// handful of calls a minute; this leaves room for that and little more.
			"name": "ALT_TEXT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 },
		},
	],
	"assets": {
		"directory": "./web-build",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/.well-known/did.json", "/oauth-client-metadata.json", "/xrpc/*"],
	},
}
